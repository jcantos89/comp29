file(STRINGS "@CMAKE_CURRENT_BINARY_DIR@/CMakeCache.txt" sanitizer REGEX "^COMP29_ENABLE_SANITIZERS:BOOL=")
if(NOT sanitizer STREQUAL "COMP29_ENABLE_SANITIZERS:BOOL=OFF")
    message(FATAL_ERROR "Test-install packages require COMP29_ENABLE_SANITIZERS=OFF and a rebuilt Release configuration")
endif()
if(NOT CPACK_BUILD_CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Use cpack -C Release")
endif()
if(NOT "@CMAKE_BUILD_TYPE@" STREQUAL "" AND NOT "@CMAKE_BUILD_TYPE@" STREQUAL "Release")
    message(FATAL_ERROR "Configure CMAKE_BUILD_TYPE=Release before packaging")
endif()
set(stage "${CPACK_TEMPORARY_DIRECTORY}")
if(NOT EXISTS "${stage}/VST3/Comp29.vst3/Contents/Resources/moduleinfo.json")
    message(FATAL_ERROR "Missing VST3 manifest; build Comp29_VST3 in Release before packaging")
endif()
set(info "Comp29 @PROJECT_VERSION@ - prerelease test-install build\nPlatform: @CMAKE_SYSTEM_NAME@ @COMP29_PACKAGE_ARCH@\nCompiler: @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@\nConfiguration: Release, sanitizers OFF\nSource: source/Comp29 and source/JUCE (matching source and notices included)\n\n")
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    find_program(readelf NAMES readelf llvm-readelf REQUIRED)
    file(GLOB plugins "${stage}/VST3/Comp29.vst3/Contents/*-linux/Comp29.so")
    list(LENGTH plugins plugin_count)
    if(NOT plugin_count EQUAL 1)
        message(FATAL_ERROR "Expected one native Linux VST3 executable")
    endif()
    set(versions "")
    foreach(binary IN ITEMS ${plugins} "${stage}/Standalone/Comp29")
        execute_process(COMMAND "${readelf}" --version-info "${binary}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot inspect ${binary}: ${error}")
        endif()
        string(APPEND versions "${output}")
        execute_process(COMMAND "${readelf}" -d "${binary}" RESULT_VARIABLE result OUTPUT_VARIABLE needed)
        if(NOT result EQUAL 0 OR needed MATCHES "lib(asan|ubsan)")
            message(FATAL_ERROR "Do not package sanitizer-linked binaries; rebuild Release with sanitizers OFF")
        endif()
    endforeach()
    foreach(prefix IN ITEMS GLIBC GLIBCXX)
        string(REGEX MATCHALL "${prefix}_[0-9.]+" required "${versions}")
        list(REMOVE_DUPLICATES required)
        list(SORT required COMPARE NATURAL ORDER DESCENDING)
        list(GET required 0 maximum)
        string(APPEND info "Highest required runtime symbol: ${maximum}\n")
    endforeach()
endif()
file(WRITE "${stage}/BUILD_INFO.txt" "${info}")
file(GLOB_RECURSE payload LIST_DIRECTORIES FALSE RELATIVE "${stage}" "${stage}/*")
list(SORT payload)
file(WRITE "${stage}/SHA256SUMS" "")
foreach(path IN LISTS payload)
    if(NOT path STREQUAL "SHA256SUMS" AND NOT IS_SYMLINK "${stage}/${path}")
        file(SHA256 "${stage}/${path}" digest)
        file(APPEND "${stage}/SHA256SUMS" "${digest}  ${path}\n")
    endif()
endforeach()
